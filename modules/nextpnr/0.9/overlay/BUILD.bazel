################################################################################
# Nexus Architecture (Lattice CrossLink-NX / Certus-NX)
################################################################################

# bbasm assembles a .bba into an embeddable chipdb C source. Built from
# nextpnr's own bba/main.cc as a host tool for the chipdb genrules below.
cc_binary(
    name = "bbasm",
    srcs = ["bba/main.cc"],
    visibility = ["//visibility:private"],
    deps = [
        "@boost.program_options//:boost.program_options",
        "@boost.system//:boost.system",
    ],
)

# Step 1: prjoxide exports the LIFCL chipdb to .bba text. prjoxide embeds the
# Lattice tile DB, so this is self-contained. (Stock prjoxide supports LIFCL;
# LFCPNX needs extra prjoxide patches and is omitted here.)
genrule(
    name = "gen_chipdb_lifcl_bba",
    srcs = [
        "nexus/constids.inc",
        "nexus/bba_version.inc",
    ],
    outs = ["nexus/chipdb-LIFCL.bba"],
    cmd = "$(location @prjoxide//libprjoxide/prjoxide:prjoxide) bba-export LIFCL $(location nexus/constids.inc) $@",
    tools = ["@prjoxide//libprjoxide/prjoxide:prjoxide"],
)

# Step 2: bbasm assembles the .bba into a self-contained C source (string-literal
# mode, `--c`). This avoids C23 `#embed`, which requires gcc>=15 / clang>=19;
# string mode compiles on the stock toolchains BCR targets.
genrule(
    name = "gen_chipdb_lifcl_cc",
    srcs = ["nexus/chipdb-LIFCL.bba"],
    outs = ["nexus/chipdb-LIFCL.cc"],
    cmd = "$(location :bbasm) --le --c $(location nexus/chipdb-LIFCL.bba) $@",
    tools = [":bbasm"],
)

# Nexus architecture - defs
cc_library(
    name = "nextpnr-nexus-defs",
    hdrs = [
        "nexus/arch.h",
        "nexus/archdefs.h",
        "nexus/bba_version.inc",
        "nexus/constids.inc",
    ],
    defines = [
        "ARCHNAME=nexus",
        "ARCH_NEXUS",
        "NEXTPNR_NAMESPACE=nextpnr_nexus",
        "NO_GUI",
        # Disable the embedded Python interpreter: nextpnr otherwise calls
        # init_python() at startup, which aborts when the Python stdlib isn't
        # found at runtime. The Nexus flow drives nextpnr via CLI, not Python.
        "NO_PYTHON",
    ],
    includes = [
        "common/kernel",
        "nexus",
    ],
)

# Nexus chipdb - embedded blob generated above. The .cc `#embed`s the .bin and
# registers an EmbeddedFile named "nexus/chipdb-LIFCL.bin" (name set by prjoxide
# in the .bba); the nexus arch loads it via get_chipdb() at startup.
cc_library(
    name = "nextpnr-nexus-chipdb",
    srcs = ["nexus/chipdb-LIFCL.cc"],
    deps = [
        ":nextpnr-nexus-defs",
        ":nextpnr_kernel_headers",
    ],
    # The chipdb TU only self-registers an EmbeddedFile (static init); without
    # alwayslink the linker drops it and get_chipdb() fails at runtime.
    alwayslink = True,
)

